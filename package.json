{
  "name": "pokemon-tcg-deck-tracker",
  "version": "1.1.0",
  "description": "Overlay deck tracker for Pokemon TCG Live",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "fetch-pipeline": "node scripts/fetch-pipeline.js",
    "test": "node test/test-inference.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "release": "electron-builder --publish always"
  },
  "keywords": [
    "pokemon",
    "tcg",
    "deck-tracker",
    "overlay"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "npyjs": "^1.1.0",
    "onnxruntime-node": "1.21.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.ptcgl.deck-tracker",
    "productName": "PTCGL Deck Tracker",
    "files": [
      "**/*",
      "!.github/**/*",
      "!.gitmodules",
      "!CLAUDE.md",
      "!scripts/**/*",
      "!test/**/*"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**"
    ],
    "extraResources": [
      {
        "from": "pipeline",
        "to": "pipeline",
        "filter": ["**/*", "!golden/**/*"]
      }
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  }
}
