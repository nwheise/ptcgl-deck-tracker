{
  "name": "pokemon-tcg-deck-tracker",
  "version": "1.0.2",
  "description": "Overlay deck tracker for Pokemon TCG Live",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "release": "electron-builder --publish always"
  },
  "keywords": [
    "pokemon",
    "tcg",
    "deck-tracker",
    "overlay"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.ptcgl.deck-tracker",
    "productName": "PTCGL Deck Tracker",
    "files": [
      "**/*",
      "!.github/**/*",
      "!.gitmodules",
      "!CLAUDE.md"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  }
}
